{
  "name": "apex-fall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist --project-name apex-fall"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "wrangler": "^4.158.0"
  }
}